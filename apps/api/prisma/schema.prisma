generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum SharePermission {
  READ
  EDIT
}

model User {
  id                  String                @id @default(cuid())
  email               String                @unique
  displayName         String
  passwordHash        String
  isEmailVerified     Boolean               @default(false)
  avatarUrl           String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  emailTokens         VerificationToken[]   @relation("EmailVerificationTokens")
  passwordResetTokens PasswordResetToken[]  @relation("PasswordResetTokens")
  refreshTokens       RefreshToken[]
  notes               Note[]
  noteProtections     NoteProtection[]
  noteSharesOwned     NoteShare[]           @relation("NoteSharesOwned")
  noteSharesReceived  NoteShare[]           @relation("NoteSharesReceived")
  notifications       Notification[]
  noteLabels          UserNoteLabel[]
  notePins            UserNotePin[]
  notificationStat    UserNotificationStat?
}

model Note {
  id         String                 @id @default(cuid())
  title      String
  content    String?
  isPinned   Boolean                @default(false)
  isShared   Boolean                @default(false)
  labels     String[]               @default([])
  userId     String
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  shares     NoteShare[]
  protection NoteProtection?
  userLabels UserNoteLabel[]
  userPins   UserNotePin[]
  revisions  NoteRevision[]
  updates    NoteUpdate[]
  snapshots  NoteSnapshotMetadata[]

  @@index([userId])
  @@index([updatedAt])
  @@index([isPinned])
}

model NoteShare {
  id             String          @id @default(cuid())
  noteId         String
  ownerId        String
  recipientId    String?
  recipientEmail String
  permission     SharePermission @default(READ)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  note           Note            @relation(fields: [noteId], references: [id], onDelete: Cascade)
  owner          User            @relation("NoteSharesOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  recipient      User?           @relation("NoteSharesReceived", fields: [recipientId], references: [id], onDelete: SetNull)

  @@unique([noteId, recipientEmail])
  @@index([noteId])
  @@index([ownerId])
  @@index([recipientId])
}

model NoteProtection {
  id           String   @id @default(cuid())
  noteId       String   @unique
  passwordHash String
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note         Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([userId, noteId])
  @@index([noteId])
}

model VerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  userId    String
  user      User      @relation("EmailVerificationTokens", fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?
  userId    String
  user      User      @relation("PasswordResetTokens", fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid(7))
  userId    String
  type      String // 'note_shared'
  title     String
  message   String
  read      Boolean  @default(false)
  data      String? // JSON string for additional context (noteId, shareId, etc)
  eventId   String?  @unique // source DomainEvent.eventId — used for idempotent processing
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([read])
}

model UserNotificationStat {
  userId      String   @id
  unreadCount Int      @default(0)
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserNoteLabel {
  id        String   @id @default(cuid())
  userId    String
  noteId    String
  labels    String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([userId, noteId])
  @@index([userId])
  @@index([noteId])
}

model UserNotePin {
  id        String   @id @default(cuid())
  userId    String
  noteId    String
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([userId, noteId])
  @@index([userId])
  @@index([noteId])
}

model OutboxMessage {
  id             String    @id @default(uuid(7))
  type           String // 'INTEGRATION_EVENT' or 'INTERNAL_COMMAND'
  topic          String // e.g. 'UserRegistered', 'SendVerificationEmail'
  payload        String // JSON payload
  status         String    @default("PENDING") // 'PENDING' | 'PROCESSING' | 'PROCESSED' | 'FAILED' | 'DEAD_LETTERED'
  retryCount     Int       @default(0) // number of failed attempts so far
  nextRetryAt    DateTime? // null until first failure; set with exponential backoff
  deadLetteredAt DateTime? // timestamp when moved to dead-letter state
  createdAt      DateTime  @default(now())
  processedAt    DateTime?

  @@index([status, nextRetryAt, createdAt]) // covers PENDING polls and retry scheduling
}

model NoteUpdate {
  seq        BigInt   @id @default(autoincrement()) // Strict monotonic ordering
  noteId     String
  authorId   String
  updateBlob Bytes // Binary Yjs update
  sizeBytes  Int // Pre-calculated size to avoid SUM() on threshold checks
  createdAt  DateTime @default(now())
  note       Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, seq(sort: Asc)]) // Optimized for replay querying
}

model NoteSnapshotMetadata {
  id          String   @id @default(uuid(7))
  noteId      String
  snapshotSeq BigInt
  s3ObjectKey String // Pointer to S3 bucket
  createdAt   DateTime @default(now())
  note        Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, snapshotSeq])
  @@index([noteId, snapshotSeq(sort: Desc)])
}

model NoteRevision {
  id        String   @id @default(uuid(7))
  noteId    String
  targetSeq BigInt // POINTER to the NoteUpdate log
  label     String?
  createdBy String
  createdAt DateTime @default(now())
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, targetSeq])
  @@index([noteId, createdAt(sort: Desc)])
}

// ─── Billing ──────────────────────────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  AWAITING_ACTION
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

/// Immutable product catalog. Plans are never deleted — only deprecated.
model Plan {
  id           String    @id // e.g. 'premium_monthly_v1'
  version      Int       @default(1)
  displayName  String
  amountCents  Int // authoritative server-side price — never trust client
  currency     String    @default("USD")
  intervalDays Int? // null = one-time / lifetime
  features     String[] // e.g. ['premium_notes']
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  deprecatedAt DateTime?

  @@unique([id, version])
  @@index([isActive])
}

/// One record per checkout/payment attempt. Immutable once in a terminal state.
model Payment {
  id              String        @id @default(uuid(7))
  billingEntityId String // userId or orgId — no FK to User (cross-BC)
  planId          String
  planVersion     Int
  amountCents     Int // server-authoritative price at time of initiation
  currency        String        @default("USD")
  status          PaymentStatus @default(PENDING)
  provider        String? // 'stripe' | 'momo' | 'mock'
  externalId      String?       @unique // provider session/transaction ID
  failureReason   String?
  correlationId   String // original HTTP request ID
  idempotencyKey  String // client-provided for deduplication
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([billingEntityId, idempotencyKey])
  @@index([billingEntityId])
  @@index([status])
  @@index([provider, externalId])
}

/// Entitlement lifecycle for a billing entity. Each renewal creates a new record period.
model Subscription {
  id                   String             @id @default(uuid(7))
  billingEntityId      String
  planId               String
  planVersion          Int
  paymentId            String             @unique // idempotency: one subscription per initiating payment
  status               SubscriptionStatus @default(ACTIVE)
  features             String[] // snapshotted at activation from plan definition
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  stripeSubscriptionId String?            @unique // for recurring webhook correlation
  cancelledAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([billingEntityId, status])
  @@index([currentPeriodEnd])
  @@index([stripeSubscriptionId])
}

/// Read model: fast-path entitlement resolution. Updated atomically in the same TX as Subscription.
model EntitlementRecord {
  billingEntityId String    @id
  features        String[]
  expiresAt       DateTime? // null = non-expiring
  updatedAt       DateTime  @updatedAt
}

/// Deduplication table for webhook events. Inserted in the same TX as payment/subscription updates.
model ProcessedWebhookEvent {
  webhookEventId String   @id // provider Event-Id (e.g. Stripe evt_xxx)
  provider       String
  processedAt    DateTime @default(now())

  @@index([processedAt])
}
